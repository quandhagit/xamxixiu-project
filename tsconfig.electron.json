{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist-electron",
    "noEmit": false
  },
  "include": [
    "src/electron/**/*.ts",
    "src/project/**/*.ts",
    "src/export/**/*.ts",
    "src/analyze.ts",
    "src/curate.ts",
    "src/match-reactions.ts",
    "src/cli.ts",
    "src/ai/**/*.ts",
    "src/tts/**/*.ts",
    "src/hyperframes/**/*.ts",
    "src/timeline/**/*.ts",
    "src/comments/**/*.ts"
  ]
}
