AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

VBEE_ACCESS_TOKEN=
VBEE_APP_ID=
# The desktop app creates this URL itself. Only needed for the CLI webhook.
VBEE_WEBHOOK_URL=https://your-tunnel.trycloudflare.com/webhooks/vbee
VBEE_WEBHOOK_PORT=3001
# Optional. The installer bundles cloudflared.exe. Set this to override it.
# CLOUDFLARED_PATH=C:\Program Files\cloudflared\cloudflared.exe

# Optional. Empty uses CapCut's default drafts folder.
# CAPCUT_DRAFTS_DIR=%LOCALAPPDATA%\CapCut\User Data\Projects\com.lveditor.draft

CAPCUT_TEMPLATE_DIR=
CAPCUT_OUTPUT_DIR=

# Fine-grained: Contents Read and write on this repo. Used by yarn release:win.
GITHUB_TOKEN=
